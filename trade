function GetDataMain(uid)
    local res = request({
        Url = getgenv().Config["Url"] .. "/getdatamain?key=" .. uid,
        Method = "GET"
    })

    local data = game:GetService("HttpService"):JSONDecode(res.Body)

    if not data or next(data) == nil then
        return {}
    end

    return data.data
end

